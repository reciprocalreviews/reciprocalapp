PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# The local stack's well-known service role key (not a secret — it is the same for every
# local Supabase install). Seeded into the vault as `service_role_key` via [db.vault] in
# supabase/config.toml, and used by send_email()/the remind cron to call the edge
# functions, which reject any caller that isn't service_role. Hosted projects use their
# own key, set as a vault secret in the Dashboard.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Resend API key. Used both for application emails (the resend/remind edge
# functions) and, in the hosted project, for Supabase auth emails via Resend's
# SMTP (see [auth.email.smtp] in supabase/config.toml).
RESEND_API_KEY=xx_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_ENV=dev