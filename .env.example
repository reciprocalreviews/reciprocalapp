PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# LOCAL ONLY. The local stack's well-known secret key (not a secret — identical on every
# local Supabase install). It seeds the `secret_key` vault entry via [db.vault] in
# supabase/config.toml AND is read by the edge functions, so the local database and the
# local functions agree on which key is valid.
#
# Named EDGE_SECRET_KEY rather than SUPABASE_SECRET_KEY because the CLI refuses to pass
# any --env-file entry beginning with SUPABASE_ ("Env name cannot start with SUPABASE_").
# Hosted projects need no equivalent variable: the runtime injects SUPABASE_SECRET_KEYS
# and SUPABASE_SERVICE_ROLE_KEY on its own. Set the `secret_key` VAULT secret there instead.
#
# Left blank on purpose. The value is the same on every local install, but committing a
# literal `sb_secret_...` trips GitHub push protection — and a checked-in string that looks
# exactly like a real credential is worth avoiding regardless. Run `npm start` (or
# `supabase start`) and copy the printed SECRET_KEY value here.
EDGE_SECRET_KEY=
# Resend API key. Used both for application emails (the resend/remind edge
# functions) and, in the hosted project, for Supabase auth emails via Resend's
# SMTP (see [auth.email.smtp] in supabase/config.toml).
RESEND_API_KEY=xx_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
# LOCAL ONLY. Seeds the `site_url` vault entry via [db.vault] in supabase/config.toml,
# which public.request_email_verification uses to build verification links. It must stay a
# variable rather than a literal in config.toml: `supabase db push` copies vault secrets to
# the remote project, so a literal would overwrite the hosted origin on every deploy.
LOCAL_SITE_URL=http://localhost:5173
PUBLIC_ENV=dev